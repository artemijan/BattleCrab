# Template for deploy.env — copy to deploy.env (gitignored) and fill in.
# ALL secrets and machine-specific values live in deploy.env; the committed
# deploy*.sh scripts hold none. Each script takes an alternative env file path
# as $1 (defaults to deploy.env next to the script).
#
# CI (see .github/workflows/deploy.yml) reconstructs deploy.env from the
# GitHub "production" environment: add each variable below as an environment
# secret (or, for non-secret values like REMOTE_HOST, an environment variable)
# NAMED EXACTLY as it appears here. The SSH private key authorized for
# REMOTE_USER@REMOTE_HOST goes into an extra DEPLOY_SSH_KEY secret. Use a
# dedicated CI keypair, not a personal key — it can then be revoked on its own
# by removing one line from the server's authorized_keys:
#
#   ssh-keygen -t ed25519 -N "" -f ~/.ssh/l2_ci_deploy -C "github-actions"
#   ssh-copy-id -i ~/.ssh/l2_ci_deploy.pub <REMOTE_USER>@<REMOTE_HOST>
#   cat ~/.ssh/l2_ci_deploy    # paste whole output into DEPLOY_SSH_KEY
#
# Do NOT set SSH_KEY below in the DEPLOY_ENV secret: the workflow writes the
# key to ~/.ssh/id_ed25519 on the runner, which ssh already uses by default.

# --- Target host (deploy.sh + deploy-dashboard.sh) ----------------------------
REMOTE_HOST=203.0.113.10
REMOTE_USER=debian
REMOTE_PATH=/home/debian/app
# Rust target of the remote box. If unset, the scripts auto-detect it over SSH;
# pin it so CI skips that round-trip.
TARGET_TRIPLE=x86_64-unknown-linux-gnu
# Optional overrides:
# SSH_PORT=22
# SSH_KEY=~/.ssh/id_ed25519   # local path override only — leave unset in CI

# --- Turnstile captcha (deploy-dashboard.sh + deploy-web.sh) ------------------
# Cloudflare dashboard -> Turnstile -> Add widget (hostname = the site domain,
# mode Managed). The site key is public and baked into the SPA; the secret is
# environment-only on the server. Leave both empty to deploy with the captcha
# disabled (the API warns at boot).
TURNSTILE_SITE_KEY=
DASHBOARD_TURNSTILE_SECRET=

# --- Dashboard API (deploy-dashboard.sh) --------------------------------------
# Session signing key, >= 32 chars. Generate: openssl rand -hex 32
# Install the SAME value on every deploy — changing it logs everyone out and
# voids outstanding password-reset links (which is also how you rotate it on
# purpose).
DASHBOARD_SESSION_SECRET=

# SMTP credentials for password-reset / verification email. Leave HOST empty to
# deploy with email disabled (links are logged instead of sent).
DASHBOARD_SMTP_HOST=
DASHBOARD_SMTP_USERNAME=
DASHBOARD_SMTP_PASSWORD=
# Optional: DASHBOARD_SMTP_PORT (587) / DASHBOARD_SMTP_FROM

# Cloudflare Tunnel token exposing the API publicly (Zero Trust -> Networks ->
# Tunnels). Leave empty to skip tunnel setup.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Cloudflare Workers site (deploy-web.sh) ----------------------------------
# API token from https://dash.cloudflare.com/profile/api-tokens, "Edit
# Cloudflare Workers" template, scoped to this one account. The account ID is
# shown on the right of any Cloudflare dashboard page.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
