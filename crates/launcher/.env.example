# Copy to `.env` and adjust. `.env` is gitignored because it points a build at a
# specific deployment; this template is committed so the required keys are discoverable.
#
# A real environment variable of the same name overrides anything set here.

# Full URL of the packaged game client.
LAUNCHER_CLIENT_URL=https://static.battlecrab.com/client.7z

# Passed to l2.exe as `IP=<value>` when the player hits Play.
LAUNCHER_SERVER_IP=79.137.70.1
