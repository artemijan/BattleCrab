{
  "name": "@battlecrab/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/dev-server.ts",
    "build": "bun run build.ts",
    "og-image": "bun run scripts/og-image.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && eslint .",
    "lint:tw": "eslint .",
    "format": "biome check --write .",
    "test": "bun test"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.0",
    "@tanstack/react-query": "^5.101.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@biomejs/biome": "^2.5.5",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bun-plugin-tailwind": "^0.1.0",
    "eslint": "^10.7.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2"
  }
