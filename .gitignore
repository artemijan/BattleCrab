.idea
dist/client/system
dist/client/SysTextures
.claude
.mcp.json
.worktrees
target/
tools/vector-dump/out/
*.db
*.db-shm
*.db-wal
dist/game/log/*
dist/login/log/*
**/.DS_Store

# Deploy configuration — every credential and machine-specific value lives
# here, never in the (committed) deploy*.sh scripts. deploy.env.example is the
# committed template; CI reconstructs this file from the DEPLOY_ENV secret.
deploy.env
# Launcher build-time config: points a build at a specific deployment
crates/launcher/.env

# The plaintext mirror `l2r-tools client-dat` unpacks the client into. The
# client itself is ignored at the top of this file; both are bulk NCsoft data,
# not ours to redistribute.
dist/client/system_decrypted
dist/client/system_encrypted
dist/client/system_roundtrip

# IDE inspection exports (Analyze | Run Inspection by Name -> Export to XML).
# Machine output about the tree, not part of it, and they land in the repo root
# where a `git add -A` would otherwise sweep them in.
/.descriptions.xml
/DuplicatedCode.xml
/DuplicatedCode_aggregate.xml

